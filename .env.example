# ───────────────────────────────────────────────────────────────
# 智能冰箱厨师 · 环境变量示例
#
# 用法：cp .env.example .env 然后填入真实值。
# .env 已在 .gitignore 中，切勿提交真实密钥。
# ───────────────────────────────────────────────────────────────

# ── 前端（构建期注入，会被内联进产物）──────────────────────────
# Supabase 项目 URL 与 anon key。
# 不填也没关系：应用会自动运行在纯离线模式（localStorage）。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Android 打包专用：Capacitor WebView 的 origin 是 https://localhost，
# 相对路径 /api 会打到 WebView 自身，因此必须注入后端绝对地址。
# 网页 / PWA 同源部署时留空即可（走相对路径 /api）。
# 用法：VITE_API_BASE=https://<your-site>.netlify.app npx vite build
VITE_API_BASE=


# ── 服务端（Netlify Functions，只在服务端读取）──────────────────
# ⚠️ 不要给下面这些加 VITE_ 前缀，否则密钥会被打包进前端产物。

# DeepSeek API Key —— 智能录入的文字意图抽取 + 菜谱推荐
# 获取：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 可选：覆盖默认 LLM 模型名（默认 deepseek-flash）
# 可用值以 `curl https://api.deepseek.com/models` 为准
# DEEPSEEK_MODEL=deepseek-flash
